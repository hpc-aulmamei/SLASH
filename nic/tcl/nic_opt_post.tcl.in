# opt_design post hook of the NIC service-layer RM (named like SLASH's, which
# service_layer_build.tcl looks up): SLASH's service-layer hook, then the GT
# quad LOCs, the clocks the static shell does not define, the DCMAC1 pblocks
# and the DCMAC timing exceptions. From the 200G RoCE RM (qsfp-loop
# roce_opt_post.tcl.in), which had the same two single-port DCMACs on this
# boundary, plus the Dynamic Configuration false paths of the four-port
# loopback (qsfp_opt_post.tcl.in, build qsfp7).
source {@SLASH_OPT_POST@}

# GT quads of the QSFP0 and QSFP2 cages. SLASH's hook LOCs them by the cell
# names of its own DCMAC stack (quietly, so it matches nothing here); left
# unplaced, the placer put QSFP2's quad on GTM_QUAD_X0Y9, which is QSFP3's
# (pins AA9...), and node B had no link (RoCE build).
foreach {q loc} {qsfp_0_n_1 GTM_QUAD_X1Y7 qsfp_2_n_3 GTM_QUAD_X0Y10} {
    set c [get_cells -quiet top_i/service_layer/$q/gt_wrapper/gtwiz_versal_0/inst/intf_quad_map_inst/quad_top_inst/gt_quad_base_0_inst/inst/quad_inst]
    if {[llength $c] != 1} {
        error "nic_opt_post: GT quad of $q not found"
    }
    set_property LOC $loc $c
    puts "nic_opt_post: LOC $loc on $c"
}

# The static shell defines no clock on the QSFP reference clock inputs, so
# without these the DCMAC clock wizards' outputs (DCMAC core / AXIS clocks and
# the GT clocks and everything they clock are left
# unconstrained. 322.265625 MHz (Versal-DCMAC board_config.tcl).
foreach port {qsfp0_322mhz_clk_p qsfp2_322mhz_clk_p} {
    set p [get_ports -quiet $port]
    if {[llength $p] == 0} {
        puts "nic_opt_post: WARNING: no port $port"
    } elseif {[llength [get_clocks -quiet -of_objects $p]] == 0} {
        create_clock -period 3.103 -name ${port}_refclk $p
        puts "nic_opt_post: create_clock 322.265625 MHz on $port"
    }
}

# Both DCMACs sit in SLR1, their clock wizards (the only MMCMs of the service
# pblock) in SLR0. DCMAC1 (DCMAC_X0Y2, clock region X0Y7) feeds the 1024-bit
# RX FIFO of seg_to_axis straight from the hard block at 391 MHz; left alone
# the placer put that FIFO and the rest of the qsfp_2_n_3 fabric next to the
# RoCE node in SLR0 and the crossing missed by 2.3 ns. Keep the DCMAC-side
# fabric of qsfp_2_n_3 (about 160 RAMB36) in the SLR1 part of the service
# pblock around DCMAC1; nic_core reaches it through the service_clk side of
# the CDC FIFOs.

# Sites of the clock regions crs that lie inside pblock parent.
proc nic_sites_in_pblock {crs parent} {
    set ranges {}
    foreach r [get_property GRID_RANGES $parent] {
        if {[regexp {^(\w+)_X(\d+)Y(\d+):\w+_X(\d+)Y(\d+)$} $r -> t x0 y0 x1 y1]} {
            lappend ranges [list $t $x0 $y0 $x1 $y1]
        }
    }
    set out {}
    foreach s [get_sites -of_objects [get_clock_regions $crs] \
            -filter {SITE_TYPE =~ SLICE* || SITE_TYPE =~ RAMB* || SITE_TYPE =~ URAM*}] {
        if {![regexp {^(\w+)_X(\d+)Y(\d+)$} $s -> t x y]} continue
        foreach r $ranges {
            lassign $r rt x0 y0 x1 y1
            if {$rt eq $t && $x >= $x0 && $x <= $x1 && $y >= $y0 && $y <= $y1} {
                lappend out $s
                break
            }
        }
    }
    return $out
}

set dc1_cells [get_cells -quiet {
    top_i/service_layer/qsfp_2_n_3/dcmac_wrapper/seg_to_axis_0
    top_i/service_layer/qsfp_2_n_3/dcmac_wrapper/axis_to_seg_0
    top_i/service_layer/qsfp_2_n_3/datapath_rx_1
    top_i/service_layer/qsfp_2_n_3/datapath_tx_1}]
if {[llength $dc1_cells] != 4} {
    error "nic_opt_post: DCMAC1 fabric cells not found ($dc1_cells)"
} else {
    set parent [get_pblocks pblock_service_layer]
    set pb [create_pblock pblock_nic_dcmac1]
    set_property PARENT $parent $pb
    resize_pblock $pb -add [nic_sites_in_pblock \
        {X0Y6 X0Y7 X1Y5 X1Y6 X2Y5 X2Y6 X3Y5 X3Y6} $parent]
    add_cells_to_pblock $pb $dc1_cells
    puts "nic_opt_post: pblock_nic_dcmac1 [get_property GRID_RANGES $pb]"

    # The TX output register and axis_to_seg feed DCMAC1 at 391 MHz through
    # two LUTs; anywhere in the pblock above the route alone can take the
    # period (build 12: -0.070 ns). Keep them in DCMAC1's clock region.
    set tx_cells [get_cells -quiet {
        top_i/service_layer/qsfp_2_n_3/datapath_tx_1/tx_path/inst/inst_skid
        top_i/service_layer/qsfp_2_n_3/dcmac_wrapper/axis_to_seg_0}]
    if {[llength $tx_cells] != 2} {
        error "nic_opt_post: DCMAC1 TX output cells not found ($tx_cells)"
    } else {
        set pb_tx [create_pblock pblock_nic_dcmac1_tx]
        set_property PARENT $pb $pb_tx
        # Hard: create_pblock is soft in this flow, and soft this one was
        # ignored in qsfp-loop build qsfp4 (-0.065 ns); hard: +0.001 ns.
        set_property IS_SOFT FALSE $pb_tx
        resize_pblock $pb_tx -add [nic_sites_in_pblock {X0Y7} $pb]
        add_cells_to_pblock $pb_tx $tx_cells
        puts "nic_opt_post: pblock_nic_dcmac1_tx [get_property GRID_RANGES $pb_tx]"
    }
}

# DCMAC core resets are asynchronous inputs; at the 782 MHz core clock the
# recovery check from the reset synchronizers of the DCMAC clock/reset
# controller cannot be met by any placement (-0.6 ns with a 0.64 ns route).
set rst_ff [get_cells -quiet -hier -filter \
    {NAME =~ top_i/service_layer/*/dcmac_reset_ctrl/* && NAME =~ *arststages_ff_reg*}]
set dcmacs [get_cells -quiet -hier -filter {REF_NAME == DCMAC}]
if {[llength $rst_ff] && [llength $dcmacs]} {
    set_false_path -from $rst_ff -to $dcmacs
    puts "nic_opt_post: false path from [llength $rst_ff] DCMAC reset synchronizer flops to the DCMACs"
}

# rst_pipe_bd (rst_dcmac_*): rstn_in comes from the static's reset logic and
# is static while the RM runs; the pipe's first stage only re-times it (build 2
# failed at -0.26 ns on the 3.5 ns route from the static into the RM).
set rp {}
foreach c [get_cells -quiet -hier -filter {NAME =~ top_i/service_layer/rst_dcmac_*/inst/pipe_reg* && IS_SEQUENTIAL}] {
    if {[string match {*pipe_reg?0?} $c]} { lappend rp $c }
}
if {[llength $rp]} {
    set_false_path -to [get_pins -of_objects $rp -filter {REF_PIN_NAME == D}]
    puts "nic_opt_post: false path into [llength $rp] rst_dcmac pipe first stages"
}

# dcmac_tx_cdc: its LUT RAM is written in service_clk and read into
# registers in the DCMAC clock; a half is only used three DCMAC cycles after
# its write pointer crossed, so bound the path by one DCMAC clock period.
set tx_mem [get_cells -quiet -hier -filter \
    {NAME =~ *tx_path/inst/inst_cdc/g_slice*mem_reg* && IS_PRIMITIVE}]
set tx_q [get_cells -quiet -hier -filter \
    {NAME =~ *tx_path/inst/inst_cdc/g_slice*q_reg* && IS_PRIMITIVE}]
if {[llength $tx_mem] && [llength $tx_q]} {
    set_max_delay -datapath_only -from $tx_mem -to $tx_q 2.5
    puts "nic_opt_post: max delay 2.5 ns from [llength $tx_mem] TX CDC LUT RAMs to [llength $tx_q] registers"
} else {
    error "nic_opt_post: TX CDC cells not found ([llength $tx_mem] RAMs, [llength $tx_q] registers)"
}

# Dynamic Configuration (nic(dynamic), NIC_DYNAMIC=1): the DCMAC IP brings config_switch
# into each serdes clock through its own synchronizer and uses the last stage
# as the select of the TX/RX lane mux (640 GT data bits at 664 MHz). Both the
# crossing and the select are static outside a rate change, which happens with
# the port held in reset. As AMD's example design (dcmac_dyn_example_top.xdc);
# without it build qsfp6 failed at -9.0 ns (sys clock -> s_out_d2_cdc_to) and
# -1.4 ns (s_out_d4 replicated 84 times).
set cs_ff [get_cells -quiet -hier -filter \
    {NAME =~ top_i/service_layer/*/dcmac_wrapper/dcmac_*/inst/*config_switch_*_cdc_sync/s_out_d* && IS_SEQUENTIAL}]
if {[llength $cs_ff]} {
    set_false_path -to [get_pins -of_objects [filter $cs_ff {NAME =~ *_cdc_to*}] -filter {REF_PIN_NAME == D}]
    set_false_path -from [get_pins -of_objects $cs_ff -filter {REF_PIN_NAME == C}]
    puts "nic_opt_post: false paths into and from [llength $cs_ff] config_switch synchronizer flops"
}

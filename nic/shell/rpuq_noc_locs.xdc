# RPU QDMA mastering (nic/shell/patch_rpuq.py): NoC site locks
# PL NMU/NSU sites copied from the NIC static's routed NoC solution (NIC_BDF_BAR=1 build, impl_1/top_wrapper.ncr).
# Without them the first build with the RPU path failed NoC placement (Place 30-1866, qnoc_rm_nsu/M02_AXIS_nsu); locking keeps the known-good layout.
set_property LOC NOC_NMU512_X0Y2 [get_cells -hierarchical -filter {NAME =~ top_i/static_region/aved/base_logic/axi_noc_rpuq/inst/S00_AXI_nmu/*/NOC_NMU512_INST}]

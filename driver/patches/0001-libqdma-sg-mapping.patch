+/*
+ * Per-request timing instrumentation for the synchronous MM submit path.
+ *
+ * When QDMA_TIMING is non-zero (compile-time flag, e.g. built with
+ * -DQDMA_TIMING=1), qdma_request_submit() emits one line per request that
+ * splits the submit cost into:
+ *
+ *   - sgl_map:  DMA-mapping the scatter-gather list (dma_map_page per entry;
+ *               this is where IOMMU programming/IOTLB flushes show up).
+ *   - proc:     qdma_descq_proc_sgt_request() -- descriptor-ring fill plus
+ *               the PIDX doorbell MMIO write that kicks the hardware.
+ *   - wait:     qdma_request_wait_for_cmpl() -- the blocking wait covering
+ *               the actual HW data movement and poll-mode completion spin.
+ *
+ * Pairs with SLASH_QDMA_TIMING in the SLASH driver, whose "submit" phase is
+ * exactly the sum of these three.
+ */
+#ifndef QDMA_TIMING
+#define QDMA_TIMING 0
+#endif

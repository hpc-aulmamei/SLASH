Bootstrap: docker
From: rockylinux:9

%files
    rpm /tmp/rpm

%post
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf distro-sync -y
    dnf install -y git langpacks-en cmake gcc gcc-c++ pkg-config ninja-build rsync \
        ncurses-compat-libs glib2 libXext libXrender-devel pixman lsb_release

    dnf install -y /tmp/rpm/*.rpm
    rm -rf /tmp/rpm

    # Timezone for Vivado
    ln -snf /usr/share/zoneinfo/Europe/Dublin /etc/localtime
    echo "Europe/Dublin" > /etc/timezone

    dnf clean all

%environment
    export TZ=Europe/Dublin
    export LC_ALL=en_US.utf-8

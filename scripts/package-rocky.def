Bootstrap: docker
From: rockylinux:9

%post
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf distro-sync -y
    dnf install -y python3 python3-devel python3-jinja2 python3-pip python3-setuptools python3-wheel \
        git langpacks-en cmake gcc gcc-c++ pkg-config ninja-build rsync systemd-rpm-macros rpm-build createrepo_c procps-ng \
        cli11-devel cppzmq-devel inih-devel jsoncpp-devel libxml2-devel systemd-devel zeromq-devel zlib-devel libyaml-devel \
        ncurses-compat-libs glib2 libXext libXrender-devel pixman lsb_release

    # Timezone for Vivado
    ln -snf /usr/share/zoneinfo/Europe/Dublin /etc/localtime
    echo "Europe/Dublin" > /etc/timezone

    dnf clean all

%environment
    export TZ=Europe/Dublin
    export LC_ALL=en_US.utf-8

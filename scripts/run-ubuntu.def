Bootstrap: docker
From: ubuntu:22.04

%files
    deb/slash-dev_*.deb /tmp/
    deb/slash-sim-emu-dev_*.deb /tmp/
    deb/slash-sim-emu_*.deb /tmp/
    deb/slashkit_*.deb /tmp/
    deb/libslash-dev_*.deb /tmp/
    deb/libslash_*.deb /tmp/
    deb/libvrtd-dev_*.deb /tmp/
    deb/libvrtd_*.deb /tmp/
    deb/libvrt-dev_*.deb /tmp/
    deb/libvrt_*.deb /tmp/

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates pkg-config git rsync bash cmake git ninja-build \
        locales locales-all libtinfo5 libc6-dev-i386 libglib2.0-0 libsm6 libxext6 libxrender-dev libpixman-1-0 lsb-core

    apt-get install -y \
        /tmp/slash-dev_*.deb \
        /tmp/slash-sim-emu-dev_*.deb \
        /tmp/slash-sim-emu_*.deb \
        /tmp/slashkit_*.deb \
        /tmp/libslash-dev_*.deb \
        /tmp/libslash_*.deb \
        /tmp/libvrtd-dev_*.deb \
        /tmp/libvrtd_*.deb \
        /tmp/libvrt-dev_*.deb \
        /tmp/libvrt_*.deb
    rm -f /tmp/*.deb

    # Timezone for Vivado
    ln -snf /usr/share/zoneinfo/Europe/Dublin /etc/localtime
    echo "Europe/Dublin" > /etc/timezone

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export TZ=Europe/Dublin
    export LC_ALL=en_US.utf-8
